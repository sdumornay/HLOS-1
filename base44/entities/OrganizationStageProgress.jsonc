{
  "name": "OrganizationStageProgress",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ]
    },
    "stage_number": {
      "type": "number",
      "description": "1-4"
    },
    "status": {
      "type": "string",
      "enum": [
        "locked",
        "available",
        "in_progress",
        "awaiting_approval",
        "completed"
      ],
      "default": "locked"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "completion_percentage": {
      "type": "number",
      "default": 0,
      "description": "0-100"
    },
    "required_deliverables": {
      "type": "array",
      "description": "Deliverable keys required for this stage",
      "items": {
        "type": "string"
      }
    },
    "completed_deliverables": {
      "type": "array",
      "description": "Deliverable keys that have been completed",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": "string",
      "description": "Email of admin who approved stage completion"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "migrated_from_legacy": {
      "type": "boolean",
      "default": false,
      "description": "True if this record was auto-created from the org's current_stage during migration"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "stage"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}