{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "coach",
        "lead_pastor",
        "team_member"
      ],
      "default": "team_member",
      "description": "super_admin = app owner/consultant with full cross-org access; coach = assigned to specific orgs; lead_pastor = org owner; team_member = standard org user"
    },
    "organization_id": {
      "type": "string",
      "description": "Primary organization (not required for super_admin)"
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed first-run onboarding"
    },
    "team_ids": {
      "type": "array",
      "description": "Teams this user belongs to",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string",
      "description": "Job title or role title"
    },
    "phone": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    }
  }
}