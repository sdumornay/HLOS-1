{
  "name": "RenewalReflection",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "reflection_date": {
      "type": "string",
      "format": "date"
    },
    "respondent_email": {
      "type": "string"
    },
    "leadership_sustainability": {
      "type": "number",
      "description": "1-10: How sustainable is your leadership right now?"
    },
    "team_relationships": {
      "type": "number",
      "description": "1-10: Health of team relationships"
    },
    "communication_health": {
      "type": "number",
      "description": "1-10: Quality of communication"
    },
    "workload": {
      "type": "number",
      "description": "1-10: How manageable is the workload? (10 = sustainable)"
    },
    "leadership_pressure": {
      "type": "number",
      "description": "1-10: How much pressure is on leadership? (10 = healthy/balanced)"
    },
    "ministry_rhythm": {
      "type": "number",
      "description": "1-10: Health of ministry rhythm and pace"
    },
    "renewal_areas": {
      "type": "string",
      "description": "Areas requiring renewal"
    },
    "reflection_notes": {
      "type": "string",
      "description": "General reflection notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complete"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "reflection_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}