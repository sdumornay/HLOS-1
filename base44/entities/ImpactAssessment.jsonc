{
  "name": "ImpactAssessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "respondent_name": {
      "type": "string"
    },
    "q1": {
      "type": "number",
      "description": "1-5. Organizational Health: people can raise problems without fear of fallout."
    },
    "q2": {
      "type": "number",
      "description": "1-5. Organizational Health: difficult issues are handled directly rather than avoided."
    },
    "q3": {
      "type": "number",
      "description": "1-5. Organizational Health: staff and volunteers remain steady under pressure."
    },
    "q4": {
      "type": "number",
      "description": "1-5. Strategic Alignment: everyone can state why the organization exists and what matters this season."
    },
    "q5": {
      "type": "number",
      "description": "1-5. Strategic Alignment: the team agrees on the few priorities that matter most right now."
    },
    "q6": {
      "type": "number",
      "description": "1-5. Strategic Alignment: people know what they own and what success looks like."
    },
    "q7": {
      "type": "number",
      "description": "1-5. Leadership Effectiveness: responsibility is distributed beyond one or two key leaders."
    },
    "q8": {
      "type": "number",
      "description": "1-5. Leadership Effectiveness: commitments are reviewed and followed up on consistently."
    },
    "q9": {
      "type": "number",
      "description": "1-5. Leadership Effectiveness: leaders are developed intentionally, not just managed."
    },
    "q10": {
      "type": "number",
      "description": "1-5. Operational Execution: committed actions are usually completed by the agreed date."
    },
    "q11": {
      "type": "number",
      "description": "1-5. Operational Execution: decisions are made in a timely way rather than deferred."
    },
    "q12": {
      "type": "number",
      "description": "1-5. Operational Execution: meetings end with clear decisions, owners, and dates."
    },
    "q13": {
      "type": "number",
      "description": "1-5. Mission Impact: programs produce the outcomes they exist to produce."
    },
    "q14": {
      "type": "number",
      "description": "1-5. Mission Impact: the people served experience real change."
    },
    "q15": {
      "type": "number",
      "description": "1-5. Mission Impact: staffing, systems, and funding can carry the current load."
    },
    "organizational_health_score": {
      "type": "number",
      "description": "Average of q1-q3 (1-5 scale)"
    },
    "strategic_alignment_score": {
      "type": "number",
      "description": "Average of q4-q6 (1-5 scale)"
    },
    "leadership_effectiveness_score": {
      "type": "number",
      "description": "Average of q7-q9 (1-5 scale)"
    },
    "operational_execution_score": {
      "type": "number",
      "description": "Average of q10-q12 (1-5 scale)"
    },
    "mission_impact_score": {
      "type": "number",
      "description": "Average of q13-q15 (1-5 scale)"
    },
    "overall_score": {
      "type": "number",
      "description": "Average of all 15 questions (1-5 scale)"
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.respondent_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.organization_id}}"
            },
            {
              "data.respondent_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}