{
  "name": "CommAgreement",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "agreement_text": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "meeting_norms",
        "conflict_protocol",
        "feedback",
        "decision_making",
        "communication_channels",
        "other"
      ],
      "default": "meeting_norms"
    },
    "agreed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of team members who agreed"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "retired"
      ],
      "default": "proposed"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "agreement_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.organization_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}