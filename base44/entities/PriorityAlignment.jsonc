{
  "name": "PriorityAlignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Priority or initiative name"
    },
    "description": {
      "type": "string"
    },
    "desired_outcome": {
      "type": "string",
      "description": "What does success look like for this priority?"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "30_day",
        "60_day",
        "90_day",
        "annual",
        "multi_year"
      ],
      "default": "90_day"
    },
    "alignment_level": {
      "type": "string",
      "enum": [
        "fully_aligned",
        "mostly_aligned",
        "partially_aligned",
        "not_aligned"
      ],
      "default": "mostly_aligned"
    },
    "owner": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "0-100 manual progress indicator"
    },
    "milestones": {
      "type": "array",
      "description": "Key milestones for this priority",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "completed_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "team_input": {
      "type": "string",
      "description": "Notes from team discussion"
    },
    "obstacles": {
      "type": "string"
    },
    "rank": {
      "type": "number",
      "description": "Priority rank (1 = highest)"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "on_hold",
        "completed"
      ],
      "default": "proposed"
    }
  },
  "required": [
    "organization_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}