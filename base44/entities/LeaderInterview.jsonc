{
  "name": "LeaderInterview",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "interviewee_name": {
      "type": "string",
      "description": "Leader's name (self-assessment)"
    },
    "interviewee_role": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "strengths_observed": {
      "type": "string",
      "description": "Perceived strengths"
    },
    "weaknesses": {
      "type": "string",
      "description": "Perceived weaknesses"
    },
    "tensions_perceived": {
      "type": "string"
    },
    "leadership_gaps": {
      "type": "string"
    },
    "hopes_for_team": {
      "type": "string"
    },
    "concerns": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "interviewee_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}