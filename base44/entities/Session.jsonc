{
  "name": "Session",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "coaching",
        "team_meeting",
        "review",
        "planning"
      ],
      "default": "team_meeting"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "description": "Decisions made during this session",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "title",
    "date"
  ]
}