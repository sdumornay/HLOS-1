{
  "name": "PlanningPeriod",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "enum": [
        "30_day",
        "60_day",
        "90_day"
      ],
      "default": "30_day"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "theme": {
      "type": "string",
      "description": "Focus theme for this period"
    },
    "goals": {
      "type": "string"
    },
    "key_risks": {
      "type": "string"
    },
    "resources_needed": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed"
      ],
      "default": "planning"
    }
  },
  "required": [
    "organization_id",
    "period"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}