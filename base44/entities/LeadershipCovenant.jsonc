{
  "name": "LeadershipCovenant",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "default": "Leadership Team Covenant"
    },
    "preamble": {
      "type": "string"
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "signatories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "signed_date": {
            "type": "string"
          }
        }
      }
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "under_review"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}