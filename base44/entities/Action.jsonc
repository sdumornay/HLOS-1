{
  "name": "Action",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ]
    },
    "plan_period": {
      "type": "string",
      "enum": [
        "30_day",
        "60_day",
        "90_day"
      ],
      "description": "Which plan period this action belongs to"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "session_id": {
      "type": "string",
      "description": "Reference to session where action was created"
    }
  },
  "required": [
    "organization_id",
    "title"
  ]
}