{
  "name": "Issue",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Reference to organization"
    },
    "title": {
      "type": "string",
      "description": "Short summary of the issue"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the problem, tension, or barrier"
    },
    "date_identified": {
      "type": "string",
      "format": "date",
      "description": "When the issue was first raised"
    },
    "identified_by": {
      "type": "string",
      "description": "Person who identified or raised the issue"
    },
    "owner": {
      "type": "string",
      "description": "Person responsible for resolving the issue"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ],
      "description": "Related LHOS stage"
    },
    "classification": {
      "type": "string",
      "enum": [
        "relational",
        "operational"
      ],
      "description": "Relational = trust/communication/conflict; Operational = priorities/processes/execution"
    },
    "classification_overridden": {
      "type": "boolean",
      "default": false,
      "description": "True if an admin manually changed the classification"
    },
    "classification_overridden_by": {
      "type": "string",
      "description": "Admin who overrode the classification"
    },
    "notes": {
      "type": "string"
    },
    "resolution": {
      "type": "string",
      "description": "How the issue was resolved"
    },
    "date_resolved": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "organization_id",
    "title",
    "classification"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.organization_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}