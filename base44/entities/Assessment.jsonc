{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "initial",
        "pulse",
        "quarterly",
        "exit"
      ],
      "default": "pulse"
    },
    "trust": {
      "type": "number",
      "description": "1-10 score"
    },
    "safety": {
      "type": "number"
    },
    "clarity": {
      "type": "number"
    },
    "accountability": {
      "type": "number"
    },
    "meeting_effectiveness": {
      "type": "number"
    },
    "conflict_intensity": {
      "type": "number",
      "description": "1-10, lower is healthier"
    },
    "overall_health": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ]
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.respondent_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.organization_id}}"
            },
            {
              "data.respondent_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}