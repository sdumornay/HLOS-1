{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "initial",
        "pulse",
        "quarterly",
        "exit"
      ],
      "default": "pulse"
    },
    "trust": {
      "type": "number",
      "description": "1-10 score"
    },
    "safety": {
      "type": "number"
    },
    "clarity": {
      "type": "number"
    },
    "accountability": {
      "type": "number"
    },
    "meeting_effectiveness": {
      "type": "number"
    },
    "conflict_intensity": {
      "type": "number",
      "description": "1-10, lower is healthier"
    },
    "overall_health": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "stabilize",
        "align",
        "execute",
        "sustain"
      ]
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ]
}