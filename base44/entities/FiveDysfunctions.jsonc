{
  "name": "FiveDysfunctions",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "trust": {
      "type": "number",
      "description": "1-5: Absence of Trust"
    },
    "conflict": {
      "type": "number",
      "description": "1-5: Fear of Conflict"
    },
    "commitment": {
      "type": "number",
      "description": "1-5: Lack of Commitment"
    },
    "accountability": {
      "type": "number",
      "description": "1-5: Avoidance of Accountability"
    },
    "results": {
      "type": "number",
      "description": "1-5: Inattention to Results"
    },
    "trust_notes": {
      "type": "string"
    },
    "conflict_notes": {
      "type": "string"
    },
    "commitment_notes": {
      "type": "string"
    },
    "accountability_notes": {
      "type": "string"
    },
    "results_notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "data.respondent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.respondent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.respondent_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}