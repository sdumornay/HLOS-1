{
  "name": "TensionPulse",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "team_tension": {
      "type": "number",
      "description": "1-10, 10 = very high tension"
    },
    "trust_level": {
      "type": "number",
      "description": "1-10"
    },
    "communication_safety": {
      "type": "number",
      "description": "1-10"
    },
    "unresolved_conflicts": {
      "type": "number",
      "description": "1-10"
    },
    "leadership_confidence": {
      "type": "number",
      "description": "1-10"
    },
    "team_morale": {
      "type": "number",
      "description": "1-10"
    },
    "biggest_tension": {
      "type": "string"
    },
    "one_change": {
      "type": "string",
      "description": "One thing that would most improve team health"
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ]
}