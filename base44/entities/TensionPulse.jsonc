{
  "name": "TensionPulse",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "respondent_email": {
      "type": "string"
    },
    "side_conversations": {
      "type": "number",
      "description": "1-10, higher = more pressure. Concerns get discussed in side conversations rather than directly with the person involved."
    },
    "decision_aftermath": {
      "type": "number",
      "description": "1-10, higher = more pressure. After decisions are made, people continue to second-guess or push back privately."
    },
    "ownership_confusion": {
      "type": "number",
      "description": "1-10, higher = more pressure. It's unclear who is responsible for what, causing overlap or things falling through the cracks."
    },
    "meeting_atmosphere": {
      "type": "number",
      "description": "1-10, higher = more pressure. Team meetings feel tense, guarded, or like walking on eggshells."
    },
    "disengagement": {
      "type": "number",
      "description": "1-10, higher = more pressure. Key people are going quiet, pulling back, or disengaging from the team."
    },
    "faction_pressure": {
      "type": "number",
      "description": "1-10, higher = more pressure. People are grouping into subgroups or factions rather than operating as one team."
    },
    "biggest_tension": {
      "type": "string",
      "description": "Where the pressure is showing up most \u2014 name the relationship or interaction"
    },
    "one_change": {
      "type": "string",
      "description": "One conversation or change that would most relieve the pressure"
    }
  },
  "required": [
    "organization_id",
    "respondent_email"
  ],
  "rls": {
    "create": {
      "data.organization_id": "{{user.organization_id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.organization_id}}"
            },
            {
              "data.respondent_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "data.organization_id": "{{user.organization_id}}"
            },
            {
              "data.respondent_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}