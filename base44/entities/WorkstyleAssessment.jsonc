{
  "name": "WorkstyleAssessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "member_email": {
      "type": "string"
    },
    "workstyle_type": {
      "type": "string",
      "enum": [
        "head",
        "heart",
        "gut",
        "feet"
      ],
      "description": "Primary workstyle"
    },
    "secondary_type": {
      "type": "string",
      "enum": [
        "head",
        "heart",
        "gut",
        "feet"
      ]
    },
    "strengths": {
      "type": "string"
    },
    "blindspots": {
      "type": "string"
    },
    "communication_preference": {
      "type": "string"
    },
    "decision_style": {
      "type": "string"
    },
    "stress_response": {
      "type": "string"
    },
    "coach_notes": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "member_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "data.organization_id": "{{user.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        }
      ]
    }
  }
}