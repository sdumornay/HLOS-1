{
  "name": "NVCConversation",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "participant_a": {
      "type": "string"
    },
    "participant_b": {
      "type": "string"
    },
    "situation": {
      "type": "string",
      "description": "What happened \u2014 objective observation"
    },
    "feelings_a": {
      "type": "string",
      "description": "Feelings of participant A"
    },
    "needs_a": {
      "type": "string",
      "description": "Underlying needs of participant A"
    },
    "request_a": {
      "type": "string",
      "description": "Specific request from participant A"
    },
    "feelings_b": {
      "type": "string",
      "description": "Feelings of participant B"
    },
    "needs_b": {
      "type": "string",
      "description": "Underlying needs of participant B"
    },
    "request_b": {
      "type": "string",
      "description": "Specific request from participant B"
    },
    "agreements_reached": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "resolved"
      ],
      "default": "draft"
    }
  },
  "required": [
    "organization_id",
    "situation"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "lead_pastor"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "coach"
              }
            },
            {
              "data.organization_id": "{{user.organization_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}